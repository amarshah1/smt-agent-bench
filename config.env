# Sources for everything this repo pulls. Every variable can be overridden from the environment.
# Benchmarks are pinned to the commits used in the paper (arXiv:2611.05668). Solvers and checkers track
# the head of their default branch (or the newest release, for Z3) unless you pin them here.

# ---- benchmarks (pinned: these are the paper's sets)
: "${VERUS_REPO:=https://github.com/amarshah1/verus_benchmarks.git}"
: "${VERUS_COMMIT:=f3b3b07e065910558a124998524330e7b2ea927f}"         # UFDTLIA/20241211-verus, 3,763 files
: "${HELDOUT_REPO:=https://github.com/amarshah1/sundance_heldout_benchmarks.git}"
: "${HELDOUT_COMMIT:=4828b941d12687fc53b09da69d5af1d671f01aaf}"       # UFDTLIA, 4,086 files
: "${DAFNY_FSTAR_RELEASE:=https://github.com/amarshah1/dafny_fstar_benchmarks/releases/download/v1.0}"
# Soundness canaries: satisfiable queries from cvc5's regression suite. Pinned so that edits to the solver
# clone cannot change them.
: "${CANARY_REPO:=https://github.com/cvc5/cvc5.git}"
: "${CANARY_COMMIT:=cvc5-1.4.2}"

# ---- solvers (the ones agents improve are built from source)
: "${SUNDANCE_REPO:=https://github.com/yaspar-org/Sundance-SMT.git}"
: "${SUNDANCE_REF:=main}"
: "${CVC5_REPO:=https://github.com/cvc5/cvc5.git}"
: "${CVC5_REF:=main}"
: "${ALTERGO_REPO:=https://github.com/OCamlPro/alt-ergo.git}"
: "${ALTERGO_REF:=next}"           # NOTE: OCamlPro Non-Commercial License; see README
: "${ALTERGO_OCAML:=5.2.1}"
# Z3 is the reference solver. "latest" means the newest GitHub release. If the release binary does not run
# on this machine (it needs a recent glibc), it is built from that release's source.
: "${Z3_VERSION:=latest}"
: "${Z3_REPO:=https://github.com/Z3Prover/z3.git}"

# ---- proof checkers
: "${LOGOS_REPO:=https://github.com/cvc5/logos.git}"          # cvc5's newest (Lean-verified) CPC checker
: "${LOGOS_REF:=main}"
: "${ETHOS_REPO:=https://github.com/cvc5/ethos.git}"          # fallback CPC checker (C++, unverified)
: "${ETHOS_REF:=cvc5-pinned}"     # the commit pinned in cvc5's contrib/get-ethos-checker
: "${DRAT_TRIM_REPO:=https://github.com/marijnheule/drat-trim.git}"
: "${DRAT_TRIM_REF:=master}"
