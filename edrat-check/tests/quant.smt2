(set-logic UFLIA)
(declare-sort Vec 0)
(declare-fun len (Vec) Int)
(declare-fun index (Vec Int) Int)
(declare-const a Vec)
(declare-const i Int)
(declare-const ub Int)
(assert (and (<= 0 i) (< i (len a))))
(assert (forall ((j Int)) (! (=> (and (<= 0 j) (< j i)) (<= (index a j) ub)) :pattern ((index a j)))))
(declare-const ub_new Int)
(assert (= ub_new (ite (> (index a i) ub) (index a i) ub)))
(assert (not (forall ((j Int)) (! (=> (and (<= 0 j) (< j (+ i 1))) (<= (index a j) ub_new)) :pattern ((index a j))))))
(check-sat)
